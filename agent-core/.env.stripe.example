# Stripe runtime adapter
# Never commit real secret values. Configure them in Railway/runtime secrets.

# Required for autonomous Stripe API calls:
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# MVP: customer one-time payment links.
STRIPE_PAYMENTS_ENABLED=false

# Optional future recurring plans.
STRIPE_BILLING_ENABLED=false
STRIPE_BILLING_PRICE_ID=price_REPLACE_ME
STRIPE_BILLING_SUCCESS_URL=https://REPLACE_ME.example/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_BILLING_CANCEL_URL=https://REPLACE_ME.example/cancel

# Optional future marketplace/platform mode. Not required for direct customer payments.
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_RETURN_URL=https://REPLACE_ME.example/connect/return
STRIPE_CONNECT_REFRESH_URL=https://REPLACE_ME.example/connect/refresh

# Optional Stripe Crypto Onramp. Keep off until Stripe approves the account for Onramp.
STRIPE_CRYPTO_ONRAMP_ENABLED=false
STRIPE_CRYPTO_ONRAMP_RETURN_URL=https://REPLACE_ME.example/onramp/return

# Reusable live Stripe catalog product for bounded task services.
STRIPE_SERVICE_PRODUCT_ID=prod_REPLACE_ME

# Public business/support metadata used by the runtime.
STRIPE_BUSINESS_URL=https://REPLACE_ME.example/stripe/business
STRIPE_SUPPORT_URL=https://REPLACE_ME.example/stripe/business
STRIPE_SUPPORT_EMAIL=REPLACE_ME@example.com
STRIPE_PRODUCT_DESCRIPTION=Small AI services business providing bounded coding, GitHub repository audits, web research, data analysis, and automation tasks.
STRIPE_STATEMENT_DESCRIPTOR=FRESH STRONG

# One-shot self-profile sync. Keep false unless a supported account-profile API path is available.
STRIPE_PROFILE_SYNC=false
